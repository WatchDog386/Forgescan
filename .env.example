# Copy this file to .env and change the values. Never commit .env.

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# development or production
ENV=development

# Only needed for Docker (PostgreSQL). Without Docker the backend uses a SQLite file in data/.
POSTGRES_PASSWORD=change-me-too

# The only addresses the system may ever block.
MONITORED_NETWORK=192.168.56.0/24

# dry_run records what would be blocked. ssh drives nftables on the protected hosts (see lab/README.md).
FIREWALL_MODE=dry_run
FIREWALL_HOSTS=
FIREWALL_SSH_KEY=
